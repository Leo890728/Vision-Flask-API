# API authentication
# Required for protected endpoints. Send it as: X-API-Key: <value>
API_KEY=change-me


# Model catalog and defaults
# Per-model settings (model_path, default_conf, half, device) live in models.yaml.
# These defaults must match model names in models.yaml with the corresponding task.
DETECT_DEFAULT_MODEL=yolo26n
SEGMENT_DEFAULT_MODEL=sam3

# Optional: point to a different model catalog for this environment.
# MODELS_CONFIG_PATH=models.yaml

# Optional: skip loading model weights at startup, useful for tests or API-only checks.
SAM3_SKIP_MODEL_LOAD=false


# Upload and request limits
# MAX_UPLOAD_MB limits each uploaded image file.
# MAX_IMAGE_PIXELS rejects decoded images that are too large.
# MAX_BATCH_IMAGES limits /batch request size.
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=30000000
MAX_BATCH_IMAGES=8


# Rate limiting
# Per-client request limit for protected API routes.
RATE_LIMIT_PER_MINUTE=60


# Output files and cleanup
# Generated masks, overlays, exports, and result files are written under OUTPUT_DIR.
# OUTPUT_URL_PREFIX is the public route prefix used to serve those files.
OUTPUT_DIR=outputs
OUTPUT_URL_PREFIX=/outputs
OUTPUT_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600


# Application startup
# When true, app.py starts the Flask development server on import/run.
SAM3_AUTOSTART_APP=true


# Async jobs and auto-queue
# JOB_WORKER_COUNT controls background workers for /v1/jobs.
# ENABLE_AUTO_QUEUE lets busy sync requests fall back to queued jobs.
JOB_WORKER_COUNT=1
JOB_RETENTION_HOURS=24
JOB_DB_PATH=data/jobs.sqlite3
ENABLE_AUTO_QUEUE=true
AUTO_QUEUE_MAX_SIZE=200


# Response cache
# Cache entries are in-memory and keyed by image + request parameters.
CACHE_TTL_SECONDS=3600


# Webhook delivery
# Failed webhook deliveries are retried with exponential backoff from WEBHOOK_RETRY_BASE_SECONDS.
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BASE_SECONDS=1.0
