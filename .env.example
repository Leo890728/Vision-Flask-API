API_KEY=change-me
SAM3_MODEL_PATH=models/sam3.1_multiplex.pt
SAM3_HALF=true
SAM3_DEVICE=auto
SAM3_DEFAULT_CONF=0.25
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=30000000
RATE_LIMIT_PER_MINUTE=60
MAX_BATCH_IMAGES=8
OUTPUT_DIR=outputs
OUTPUT_URL_PREFIX=/outputs
OUTPUT_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600
SAM3_SKIP_MODEL_LOAD=false
SAM3_AUTOSTART_APP=true
JOB_WORKER_COUNT=1
JOB_RETENTION_HOURS=24
JOB_DB_PATH=data/jobs.sqlite3
ENABLE_AUTO_QUEUE=true
AUTO_QUEUE_MAX_SIZE=200
CACHE_TTL_SECONDS=3600
WEBHOOK_TIMEOUT_SECONDS=5
